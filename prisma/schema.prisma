generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id               BigInt            @id @default(autoincrement())
  name             String            @db.VarChar(120)
  email            String            @unique(map: "owners_email_unique") @db.VarChar(320)
  passwordHash     String            @map("password_hash")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  customers        Customer[]
  finishedProducts FinishedProduct[]
  payments         Payment[]
  productReturns   ProductReturn[]
  productions      Production[]
  purchases        Purchase[]
  rawMaterials     RawMaterial[]
  sales            Sale[]

  @@map("owners")
}

model RawMaterial {
  id           BigInt       @id @default(autoincrement())
  ownerId      BigInt       @map("owner_id")
  name         String       @db.VarChar(160)
  sku          String       @db.VarChar(80)
  unit         String       @db.VarChar(30)
  openingStock Decimal      @default(0) @map("opening_stock") @db.Decimal(18, 3)
  reorderLevel Decimal      @default(0) @map("reorder_level") @db.Decimal(18, 3)
  unitCost     Decimal      @default(0) @map("unit_cost") @db.Decimal(18, 2)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner        Owner        @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productions  Production[]
  purchases    Purchase[]

  @@unique([ownerId, sku], map: "raw_materials_owner_sku_unique")
  @@map("raw_materials")
}

model FinishedProduct {
  id             BigInt          @id @default(autoincrement())
  ownerId        BigInt          @map("owner_id")
  name           String          @db.VarChar(160)
  sku            String          @db.VarChar(80)
  unit           String          @db.VarChar(30)
  openingStock   Decimal         @default(0) @map("opening_stock") @db.Decimal(18, 3)
  reorderLevel   Decimal         @default(0) @map("reorder_level") @db.Decimal(18, 3)
  salePrice      Decimal         @default(0) @map("sale_price") @db.Decimal(18, 2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner          Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productReturns ProductReturn[]
  productions    Production[]
  sales          Sale[]

  @@unique([ownerId, sku], map: "finished_products_owner_sku_unique")
  @@map("finished_products")
}

model Customer {
  id             BigInt          @id @default(autoincrement())
  ownerId        BigInt          @map("owner_id")
  name           String          @db.VarChar(160)
  phone          String          @db.VarChar(60)
  email          String          @db.VarChar(320)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner          Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments       Payment[]
  productReturns ProductReturn[]
  sales          Sale[]

  @@unique([ownerId, email], map: "customers_owner_email_unique")
  @@map("customers")
}

model Purchase {
  id         BigInt      @id @default(autoincrement())
  ownerId    BigInt      @map("owner_id")
  supplier   String      @db.VarChar(160)
  materialId BigInt      @map("material_id")
  quantity   Decimal     @db.Decimal(18, 3)
  unitCost   Decimal     @map("unit_cost") @db.Decimal(18, 2)
  occurredAt DateTime    @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  material   RawMaterial @relation(fields: [materialId], references: [id], onUpdate: NoAction)
  owner      Owner       @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ownerId, occurredAt(sort: Desc)], map: "purchases_owner_date_idx")
  @@map("purchases")
}

model Production {
  id               BigInt          @id @default(autoincrement())
  ownerId          BigInt          @map("owner_id")
  materialId       BigInt          @map("material_id")
  materialQuantity Decimal         @map("material_quantity") @db.Decimal(18, 3)
  productId        BigInt          @map("product_id")
  productQuantity  Decimal         @map("product_quantity") @db.Decimal(18, 3)
  occurredAt       DateTime        @map("occurred_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  material         RawMaterial     @relation(fields: [materialId], references: [id], onUpdate: NoAction)
  owner            Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product          FinishedProduct @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@index([ownerId, occurredAt(sort: Desc)], map: "productions_owner_date_idx")
  @@map("productions")
}

model Sale {
  id         BigInt          @id @default(autoincrement())
  ownerId    BigInt          @map("owner_id")
  customerId BigInt          @map("customer_id")
  productId  BigInt          @map("product_id")
  quantity   Decimal         @db.Decimal(18, 3)
  unitPrice  Decimal         @map("unit_price") @db.Decimal(18, 2)
  occurredAt DateTime        @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer        @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  owner      Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    FinishedProduct @relation(fields: [productId], references: [id], onUpdate: NoAction)
  payments   Payment[]

  @@index([ownerId, occurredAt(sort: Desc)], map: "sales_owner_date_idx")
  @@map("sales")
}

model ProductReturn {
  id         BigInt          @id @default(autoincrement())
  ownerId    BigInt          @map("owner_id")
  customerId BigInt          @map("customer_id")
  productId  BigInt          @map("product_id")
  quantity   Decimal         @db.Decimal(18, 3)
  unitPrice  Decimal         @map("unit_price") @db.Decimal(18, 2)
  occurredAt DateTime        @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer        @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  owner      Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    FinishedProduct @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@index([ownerId, occurredAt(sort: Desc)], map: "product_returns_owner_date_idx")
  @@map("product_returns")
}

model Payment {
  id         BigInt   @id @default(autoincrement())
  ownerId    BigInt   @map("owner_id")
  customerId BigInt   @map("customer_id")
  amount     Decimal  @db.Decimal(18, 2)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  note       String   @default("Customer payment received") @db.VarChar(500)
  saleId     BigInt?  @map("sale_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sale       Sale?    @relation(fields: [saleId], references: [id], onUpdate: NoAction)

  @@index([ownerId, occurredAt(sort: Desc)], map: "payments_owner_date_idx")
  @@map("payments")
}
